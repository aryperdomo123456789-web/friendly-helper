@theme inline {
  --color-gold: var(--gold);
  --color-online: var(--online);
}

body {
  background-image: none;
  background-attachment: fixed;
  transition: background-color 0.3s ease, color 0.3s ease;
}

[data-theme="azul"] body {
  background-image:
    radial-gradient(1000px 500px at 12% -10%, oklch(0.68 0.16 249 / 0.16), transparent 60%),
    radial-gradient(900px 500px at 105% 0%, oklch(0.6 0.14 300 / 0.12), transparent 60%);
}

.wp-scroll::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
.wp-scroll::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, var(--scrollbar-thumb), oklch(0.76 0.18 249 / 0.98));
  border-radius: 999px;
  border: 2px solid var(--scrollbar-track);
}

.wp-scroll::-webkit-scrollbar-thumb:hover {
  background: var(--scrollbar-thumb-hover);
}

.custom-scrollbar {
  scrollbar-width: thin;
  scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
}

.custom-scrollbar::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, var(--scrollbar-thumb), oklch(0.76 0.18 249 / 0.98));
  border-radius: 999px;
  border: 2px solid var(--scrollbar-track);
}

.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: var(--scrollbar-thumb-hover);
}
